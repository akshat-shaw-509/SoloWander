# Copy these values into apps/web/.env.local for local Next.js development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Free SOS dispatch outside the app.
DISCORD_SOS_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_IDS=your-private-chat-id

# Optional custom webhook, also free if you point it at your own endpoint.
SOS_DISPATCH_WEBHOOK_URL=
SOS_DISPATCH_WEBHOOK_SECRET=

# Optional paid telecom dispatch. Leave blank for a zero-cost build.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=

# Optional free-tier email dispatch.
RESEND_API_KEY=
SOS_EMAIL_FROM=
SOS_EMAIL_TO=
